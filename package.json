    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "bootstrap": "5.3.3",
    "nodemon": "^3.1.11",
    "playwright": "1.63.0",
    "supertest": "^7.3.2"
